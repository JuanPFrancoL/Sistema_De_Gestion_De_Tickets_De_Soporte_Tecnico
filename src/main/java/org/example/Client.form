<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.example.Client">
  <grid id="27dc6" binding="panelPrincipalClient" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="1131" class="javax.swing.JLabel" binding="lblClientTitle">
        <constraints border-constraint="North"/>
        <properties>
          <font name="Segoe UI" size="22" style="1"/>
          <foreground color="-16497010"/>
          <text value="Panel Cliente"/>
        </properties>
      </component>
      <grid id="5c605" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="3" left="4" bottom="10" right="10"/>
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-5197648"/>
          <font name="Segoe UI Light"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="1001f" class="javax.swing.JButton" binding="btnCreateTicket">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-16497010"/>
              <font name="Segoe UI Light"/>
              <foreground color="-1"/>
              <text value="Crear ticket"/>
            </properties>
          </component>
          <component id="84d3b" class="javax.swing.JButton" binding="btnClose">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-6880768"/>
              <font name="Segoe UI Light"/>
              <foreground color="-1"/>
              <text value="Cerrar"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
